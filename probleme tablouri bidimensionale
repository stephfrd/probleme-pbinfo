#include <iostream>

using namespace std;

int main()
{
    int a[100][100], i, j, n, s1=0, s2=0, dif=0;
    cin>>n;
    for(i=1; i<=n; i++){
        for(j=1; j<=n; j++){
            cin>>a[i][j];
        }
    }
    for(i=1; i<=n; i++){
        s1=s1+a[i][i];
    }
    for(i=1; i<=n; i++){
        s2=s2+a[i][n+1-i];
    }
    if(s2>s1){
        dif=s2-s1;
    }
    else {
        dif=s1-s2;
    }
    cout<<dif;
    return 0;
}

